@page
@model InvoiceManager.AdminWeb.Pages.Configurations.IndexModel
@{ ViewData["Title"] = "Invoice configurations"; }
<section class="admin-shell">
    <div class="page-heading"><p class="eyebrow">Operations</p><h1>Invoice configurations</h1>
        <p class="summary">Manage recurring invoice expectations. Changes apply only to future expected records.</p></div>
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage)) { <div class="notice">@Model.StatusMessage</div> }
    @if (!Model.HasWorkflowAuthorization) { <div class="notice warning">Microsoft authorization is not captured. You may list configurations and inspect history, but configuration changes are disabled.</div> }
    <div class="actions">
        @if (Model.EditingEnabled)
        {
            <a asp-page="Create" class="primary-action">Create</a>
            <a asp-page="Import" class="secondary-action">Import from file</a>
        }
        else
        {
            <button type="button" class="primary-action" disabled title="Capture Microsoft authorization before creating configurations.">Create</button>
        }
    </div>
    <div class="configuration-list">
    @foreach (var item in Model.Configurations.OrderBy(x => x.Configuration.InvoiceDescription)) {
        var configuration = item.Configuration;
        <section class="status-panel">
            <h2>@(string.IsNullOrWhiteSpace(configuration.InvoiceDescription) ? configuration.Id.Value : configuration.InvoiceDescription)</h2>
            <dl class="field-list">
                <div>
                    <dt>Configuration ID</dt>
                    <dd>@configuration.Id</dd>
                </div>
                <div>
                    <dt>Integration</dt>
                    <dd>@(configuration.IntegrationType == InvoiceManager.Core.IntegrationType.MicrosoftBilling ? "Microsoft billing" : "Microsoft 365 email")</dd>
                </div>
                <div>
                    <dt>Status</dt>
                    <dd>@(configuration.IsActive ? "Active" : "Inactive")</dd>
                </div>
                @switch (configuration.IntegrationConfiguration)
                {
                    case InvoiceManager.Core.MicrosoftBillingIntegrationConfiguration billing:
                        <div>
                            <dt>Billing account</dt>
                            <dd>
                                <details class="billing-id-details">
                                    <summary>@(Model.BillingAccountLabels.GetValueOrDefault(billing.BillingAccountId, billing.BillingAccountId)) <span class="show-id-toggle">Show ID</span></summary>
                                    <span class="billing-id-value">@billing.BillingAccountId</span>
                                </details>
                            </dd>
                        </div>
                        break;
                    case InvoiceManager.Core.GraphEmailIntegrationConfiguration email:
                        <div>
                            <dt>Sender</dt>
                            <dd>@email.SenderEmailAddress</dd>
                        </div>
                        break;
                }
                <div>
                    <dt>OneDrive folder</dt>
                    <dd>@configuration.OneDriveFolder.DriveName · @configuration.OneDriveFolder.FolderPath</dd>
                </div>
                @if (configuration.FreeAgentMatching is InvoiceManager.Core.FreeAgentBillMatching freeAgentMatching)
                {
                    <div>
                        <dt>FreeAgent matching</dt>
                        <dd>
                            Contact: @freeAgentMatching.Contact.DisplayName<br />
                            Date: @(freeAgentMatching.DateReconciliation is InvoiceManager.Core.FreeAgentDateReconciliation dateReconciliation ? $"reconcile within {dateReconciliation.ToleranceDays} day(s)" : "exact match only")<br />
                            Amount: @(freeAgentMatching.AmountReconciliation is InvoiceManager.Core.FreeAgentAmountReconciliation amountReconciliation ? $"reconcile within {amountReconciliation.AmountTolerance:0.00}" : "exact match only")
                        </dd>
                    </div>
                }
            </dl>
            <div class="actions">
                <a asp-page="History" asp-route-id="@configuration.Id.Value" asp-route-integrationType="@configuration.IntegrationType" class="secondary-action">History</a>
                <a asp-page-handler="Export" asp-route-id="@configuration.Id.Value" asp-route-integrationType="@configuration.IntegrationType" class="secondary-action">Export</a>
                @if (Model.EditingEnabled) {
                    <a asp-page="Edit" asp-route-id="@configuration.Id.Value" asp-route-integrationType="@configuration.IntegrationType" class="secondary-action">Edit</a>
                    <form method="post">
                        <input type="hidden" name="id" value="@configuration.Id.Value" /><input type="hidden" name="integrationType" value="@configuration.IntegrationType" />
                        @* .ToString() is required: Razor applies HTML5 boolean-attribute semantics
                           (render "value=value" when true, omit the attribute when false) to ANY
                           attribute whose expression type is bool, not just disabled/checked/etc.
                           Without it, this posts a literally unparseable "value" string (or nothing
                           at all) instead of "True"/"False", so `activate` always model-binds to
                           its bool default (false) regardless of the actual intended direction. *@
                        <input type="hidden" name="etag" value="@item.ETag" /><input type="hidden" name="activate" value="@((!configuration.IsActive).ToString())" />
                        <button asp-page-handler="SetActive" class="secondary-action"
                            title="@(configuration.IsActive ? "Deactivation preserves history; outstanding records will be skipped until reactivated." : "Activation resumes processing on the next scheduled or manual workflow run.")">
                            @(configuration.IsActive ? "Deactivate" : "Activate")
                        </button>
                    </form>
                    <form method="post">
                        <input type="hidden" name="id" value="@configuration.Id.Value" /><input type="hidden" name="integrationType" value="@configuration.IntegrationType" />
                        @* "confirmed" is only actually required when the most recent record is FreeAgentInterventionPending
                           (see InvoiceRecordResync.RequiresConfirmation) - harmless to tick for any other state, but always
                           shown here since this page doesn't otherwise know a row's record state without an extra lookup. *@
                        <label class="import-confirmation"><input type="checkbox" name="confirmed" value="true" /> Confirm</label>
                        <button asp-page-handler="ResyncStuckRecord" class="secondary-action"
                            title="Refreshes this configuration's most recent record from the current search criteria and retries it the next time this (active) configuration is processed. Use after editing the configuration to fix a record stuck as Expected, RetrievalError, or NotFound. If the record is awaiting a Guess-removal intervention decision, this supersedes it - tick Confirm first.">
                            Resync stuck record
                        </button>
                    </form>
                }
            </div>
        </section>
    }
    </div>
</section>
