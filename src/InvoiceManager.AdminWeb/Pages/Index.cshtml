@page
@model IndexModel
@using InvoiceManager.Core
@using InvoiceManager.Core.Integrations.FreeAgent
@{
    ViewData["Title"] = "Invoice processing";
}

<section class="admin-shell">
    <div class="page-heading">
        <p class="eyebrow">InvoiceManager Admin</p>
        <h1>Invoice processing</h1>
        <p class="summary">
            Review invoice processing status and apply fixes.
        </p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="notice@(Model.StatusIsWarning ? " warning" : "")">@Model.StatusMessage</div>
    }
    @if (!Model.HasWorkflowAuthorization)
    {
        <div class="notice warning">Microsoft authorization is not captured. You may view invoice sync status, but resyncing a stuck record is disabled.</div>
    }

    <section class="status-panel">
        <h2>Invoice records</h2>
        <p class="status-label">
            Processing status for each configuration. Every non-complete record, plus latest one completed.
            Click a column header to sort.
        </p>
        @if (Model.Rows.Count == 0)
        {
            <p class="status-label">No invoice records have been generated yet.</p>
        }
        else
        {
            <div class="table-scroll">
                <div class="invoice-sync-grid" role="table" aria-label="Invoice records">
                    <div role="rowgroup" class="grid-contents header-rowgroup">
                        <div role="row" class="grid-contents">
                            <div role="columnheader"></div>
                            <div role="columnheader">@SortHeader(InvoiceSyncSortColumn.Configuration, "Configuration")</div>
                            <div role="columnheader">@SortHeader(InvoiceSyncSortColumn.Date, "Date")</div>
                            <div role="columnheader">@SortHeader(InvoiceSyncSortColumn.Status, "Status")</div>
                            <div role="columnheader">Diagnostic</div>
                            <div role="columnheader"></div>
                        </div>
                    </div>
                    <div role="rowgroup" class="grid-contents">
                        @foreach (var row in Model.Rows)
                        {
                            var rowClass = $"invoice-sync-row {BucketClass(row.Bucket)}{(row.IsActive ? "" : " is-inactive")}";
                            <div role="row" class="@rowClass">
                                <div role="cell" class="stripe-cell"></div>
                                <div role="cell" class="config-cell">
                                    <span class="config-name">@row.DisplayName</span>
                                    <span class="config-sub">@(row.IsActive ? "" : "Inactive · ")@(row.IntegrationType == IntegrationType.MicrosoftBilling ? "Microsoft billing" : "Microsoft 365 email")</span>
                                </div>
                                <div role="cell" class="date-cell">
                                    @row.Date.ToString("d MMM yyyy")
                                    @if (!row.IsActualDate)
                                    {
                                        <span class="date-sub">expected</span>
                                    }
                                </div>
                                <div role="cell" class="status-cell">
                                    <span class="sync-pill @BucketPillClass(row.Bucket)" title="@row.StateName">@BucketLabel(row.Bucket)</span>
                                </div>
                                <div role="cell" class="diagnostic@(row.Bucket == InvoiceSyncBucket.NeedsAttention ? " is-error" : "")@(row.Diagnostic is string ? "" : " diagnostic-empty")">
                                    @(row.Diagnostic is string diagnostic ? diagnostic : "—")
                                </div>
                                <div role="cell" class="actions-cell">
                                    @if (Model.HasWorkflowAuthorization)
                                    {
                                        <details class="row-actions" name="row-actions">
                                            <summary aria-label="Actions for @row.DisplayName"></summary>
                                            <div class="row-actions-panel">
                                                <a class="row-action-item" asp-page="/Configurations/Edit" asp-route-id="@row.ConfigurationId.Value" asp-route-integrationType="@row.IntegrationType">Edit configuration</a>
                                                @if (row.OneDrive is OneDriveDetails oneDrive)
                                                {
                                                    @if (Model.IsHttpsUrl(oneDrive.OneDriveLocation))
                                                    {
                                                        <a class="row-action-item" href="@oneDrive.OneDriveLocation">Open file</a>
                                                    }
                                                    @if (oneDrive.FolderLocation is string folderLocation && Model.IsHttpsUrl(folderLocation))
                                                    {
                                                        <a class="row-action-item" href="@folderLocation">Open folder</a>
                                                    }
                                                }
                                                @if (row.FreeAgentBill is FreeAgentBillIdentity bill && Model.FreeAgentBillUrl(bill) is string billUrl)
                                                {
                                                    <a class="row-action-item" href="@billUrl">Open FreeAgent bill</a>
                                                }
                                                @if (row.CanResync)
                                                {
                                                    if (row.ResyncRequiresConfirmation)
                                                    {
                                                        <div class="row-action-confirm">
                                                            <p>This will supersede the pending Guess-removal intervention without a decision being recorded.</p>
                                                            <form method="post">
                                                                <input type="hidden" name="id" value="@row.ConfigurationId.Value" />
                                                                <input type="hidden" name="integrationType" value="@row.IntegrationType" />
                                                                <input type="hidden" name="sort" value="@Model.Sort" />
                                                                <input type="hidden" name="descending" value="@Model.SortDescending" />
                                                                <label><input type="checkbox" name="confirmed" value="true" /> Confirm</label>
                                                                <button asp-page-handler="ResyncRecord" class="row-action-item">Resync anyway</button>
                                                            </form>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <form method="post">
                                                            <input type="hidden" name="id" value="@row.ConfigurationId.Value" />
                                                            <input type="hidden" name="integrationType" value="@row.IntegrationType" />
                                                            <input type="hidden" name="sort" value="@Model.Sort" />
                                                            <input type="hidden" name="descending" value="@Model.SortDescending" />
                                                            <button asp-page-handler="ResyncRecord" class="row-action-item">Resync</button>
                                                        </form>
                                                    }
                                                }
                                            </div>
                                        </details>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </section>

    <section class="status-panel" style="margin-top:24px;">
        <h2>Manually process invoices</h2>
        <p class="status-label">
            Invoice processing runs at the start of every hour. Use this button to trigger an extra run of the processing loop.
        </p>
        <form method="post" class="actions">
            <input type="hidden" name="sort" value="@Model.Sort" />
            <input type="hidden" name="descending" value="@Model.SortDescending" />
            <button asp-page-handler="GenerateExpectedRecords" class="secondary-action">
                Start
            </button>
        </form>
    </section>
</section>

@functions {
    private Microsoft.AspNetCore.Html.IHtmlContent SortHeader(InvoiceSyncSortColumn column, string label)
    {
        var isCurrent = Model.Sort == column;
        var nextDescending = isCurrent ? !Model.SortDescending : column == InvoiceSyncSortColumn.Date;
        var href = Url.Page("/Index", new { sort = column, descending = nextDescending });
        var indicator = isCurrent ? (Model.SortDescending ? " ▼" : " ▲") : "";
        return new Microsoft.AspNetCore.Html.HtmlString(
            $"<a class=\"sort-header\" href=\"{href}\" aria-label=\"Sort by {label}\">{label}{indicator}</a>");
    }

    private static string BucketClass(InvoiceSyncBucket bucket) => bucket switch
    {
        InvoiceSyncBucket.Complete => "bucket-complete",
        InvoiceSyncBucket.NeedsAttention => "bucket-needs-attention",
        InvoiceSyncBucket.InProgress => "bucket-in-progress",
        _ => "",
    };

    private static string BucketPillClass(InvoiceSyncBucket bucket) => bucket switch
    {
        InvoiceSyncBucket.Complete => "sync-pill-complete",
        InvoiceSyncBucket.NeedsAttention => "sync-pill-needs-attention",
        InvoiceSyncBucket.InProgress => "sync-pill-in-progress",
        _ => "",
    };

    private static string BucketLabel(InvoiceSyncBucket bucket) => bucket switch
    {
        InvoiceSyncBucket.Complete => "Complete",
        InvoiceSyncBucket.NeedsAttention => "Needs attention",
        InvoiceSyncBucket.InProgress => "In progress",
        _ => "",
    };
}
